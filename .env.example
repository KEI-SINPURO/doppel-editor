# ============================================================
# .env.example
# このファイルを .env にコピーして値を埋めてください。
# .env は絶対にリポジトリにコミットしない・公開しないこと
# （テック甲子園の応募規約でもAPIキーの取り扱いに注意するよう明記されています）
# ============================================================

# Supabase（ログイン・データ保存）
# https://app.supabase.com のプロジェクト設定 > API から取得
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# Claude API（Anthropic）
# https://console.anthropic.com でAPIキーを発行
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# デプロイ後の本番URL（Googleログインのリダイレクト先として使用）
# 例: https://doppel-editor.streamlit.app
APP_PUBLIC_URL=https://your-deployed-app-url.example.com
